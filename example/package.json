{
  "name": "email-host-example",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fantastic.dev/convex-cf-email-service": "workspace:*",
    "convex": "1.46.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "deploy:backend": "convex deploy --env-file deployment.env --cmd 'pnpm run build' --cmd-url-env-var-name VITE_CONVEX_URL",
    "deploy:site": "node ../scripts/deploy-canary.mjs",
    "deploy:canary": "node ../scripts/deploy-canary.mjs",
    "check:deployment": "wrangler deploy --dry-run && wrangler deploy --config wrangler.canary.jsonc --dry-run"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "wrangler": "4.149.0"
  }
}
