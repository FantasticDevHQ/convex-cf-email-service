{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "convex-cf-email-demo",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/send"],
  },
  "routes": [{ "pattern": "cf-email.fantastic.dev", "custom_domain": true }],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["demo@cf-email.fantastic.dev"],
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "convex-cf-email-canary-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "convex-cf-email-canary-events-dlq",
      },
    ],
  },
  "vars": {
    "ACCOUNT_ID": "c825b57320ccfc6c1fff4c6c840279d0",
    "ZONE_ID": "6d0d1d40f159f4d951851046253ea045",
    "SENDING_DOMAIN": "cf-email.fantastic.dev",
    "SUBSCRIPTION_ID": "687b1b24c10e4f3c92052beec357628e",
    "CONVEX_EVENTS_URL": "https://prestigious-lemur-549.convex.site/email/events",
  },
}
