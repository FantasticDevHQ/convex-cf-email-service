{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "convex-cf-email-demo",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "cf-email.fantastic.dev", "custom_domain": true }],
}
